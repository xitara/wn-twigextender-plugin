{
    "name": "wn-twigextender-plugin",
    "version": "1.1.0",
    "description": "Twig extender plugin for Winter CMS",
    "author": "Manuel Burghammer",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/xitara/wn-twigextender-plugin.git"
    },
    "scripts": {
        "install": "node ./scripts/setup.js && node ./scripts/composer.js",
        "prepare": "husky",
        "build": "webpack --mode production --progress",
        "dbuild": "webpack --mode development --progress",
        "watch": "webpack --watch --mode production --progress",
        "dwatch": "webpack --watch --mode development --progress",
        "build-all": "yarn dbuild && yarn build --env removeFunctions=true",
        "zip": "node ./scripts/pack.js",
        "upload": "node ./scripts/upload.js",
        "deploy": "node ./scripts/pack.js && node ./scripts/upload.js",
        "docs": "node ./scripts/phpdoc.js && node ./scripts/startBrowser.js ./.docs/api/index.html",
        "analyze": "webpack --mode production --env analyze=true && webpack-bundle-analyzer ./assets/stats.json",
        "lint": "yarn lint-js && yarn lint-ts && yarn lint-style && yarn lint-php && yarn lint-php-style && yarn typecheck",
        "lint-js": "eslint scripts test webpack *.js",
        "lint-ts": "eslint 'src/ts/**/*.ts' --no-error-on-unmatched-pattern",
        "lint-style": "stylelint 'src/**/*.{css,scss}'",
        "lint-php": "node ./scripts/lint-php.js",
        "lint-php-style": "vendor/bin/php-cs-fixer check --diff --using-cache=no",
        "lint-fix": "eslint scripts test webpack src/ts *.js --fix && stylelint 'src/**/*.{css,scss}' --fix && vendor/bin/php-cs-fixer fix --using-cache=no && prettier --write .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format-check": "prettier --check .",
        "test-build": "node ./scripts/check-build.js",
        "test-unit": "node --test 'test/**/*.test.js' && php test/twig-filter.php",
        "test": "yarn lint && yarn format-check && yarn test-unit && yarn build && yarn test-build",
        "cleanup": "node ./scripts/cleanup.js",
        "ncu": "ncu -u",
        "update-browserslist": "npx --yes update-browserslist-db@latest",
        "start": "webpack serve --open --mode development --progress"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@babel/core": "^8.0.1",
        "@babel/plugin-transform-runtime": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/runtime": "^8.0.0",
        "@prettier/plugin-php": "^0.25.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mark.js": "^8.11.12",
        "@types/node": "^26.1.2",
        "autoprefixer": "^10.5.4",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^7.0.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "glob": "^13.0.6",
        "globals": "^17.9.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "mini-css-extract-plugin": "^2.10.2",
        "npm-check-updates": "^23.0.0",
        "postcss": "^8.5.25",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "tailwindcss": "^4.3.3",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "typescript-eslint": "^8.65.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.109.2",
        "webpack-assets-manifest": "^6.5.2",
        "webpack-bundle-analyzer": "^5.3.1",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1",
        "webpack-stats-plugin": "1.1.3",
        "webpack-remove-empty-scripts": "^1.1.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "lint-staged": {
        "*.{js,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,scss}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.php": [
            "prettier --write",
            "node ./scripts/lint-php.js",
            "vendor/bin/php-cs-fixer fix --using-cache=no"
        ],
        "*.{json,json5,md,yaml,yml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "alpinejs": "^3.15.8",
        "bootstrap": "^5.3.8",
        "glightbox": "^3.3.1",
        "highlight.js": "^11.11.1",
        "mark.js": "^8.11.1",
        "micromodal": "^0.7.0",
        "rellax": "^1.12.1",
        "simplebar": "^6.3.3",
        "tiny-slider": "^2.9.4",
        "vanilla-lazyload": "^19.1.3"
    }
}
